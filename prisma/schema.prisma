datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_ACTIVATION
}

enum ChallengePurpose {
  REGISTRATION
  PASSWORD_RECOVERY
  PASSWORD_CHANGE
  ACCOUNT_ACTIVATION
}

enum FacultyApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum FacultyInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum FacultyInvitationDelivery {
  EMAIL
  LINK
}

enum FacultyDocumentType {
  GOVERNMENT_ID
  DEGREE_CERTIFICATE
  EXPERIENCE_LETTER
  BACKGROUND_CHECK
  OTHER
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

// Catalogue tree (screen 28). Types follow this order from root to leaf;
// SUBSECTION and BOARD may be skipped. LEVEL nodes are leaves.
enum CatalogueNodeType {
  CATEGORY
  SUBSECTION
  BOARD
  SUBJECT
  LEVEL
}

enum CatalogueNodeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LibraryMaterialKind {
  DOCUMENT
  LINK
}

enum LibraryMaterialAudience {
  STUDENT
  FACULTY
  ALL
}

enum LibraryModerationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

// Onboarding step 3 relationship dropdown. Final option list pending from the UI owner.
enum GuardianRelationship {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

enum PolicyType {
  TERMS_OF_USE
  PRIVACY_POLICY
  CHILD_SAFETY_POLICY
  STUDENT_TERMS
}

enum SignatureMode {
  DRAW
  TYPE
}

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String     @unique @db.VarChar(255)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  fullName            String     @map("full_name") @db.VarChar(150)
  // E.164, e.g. +919876543210. Not unique: siblings may share a parent's number.
  mobileNumber        String?    @map("mobile_number") @db.VarChar(16)
  // IANA zone, e.g. Asia/Kolkata, captured from the browser at registration
  timezone            String?    @db.VarChar(64)
  isActive            Boolean    @default(true) @map("is_active")
  status              UserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  securityVersion     Int        @default(1) @map("security_version")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  lastLoginIp         String?    @map("last_login_ip") @db.VarChar(45)
  lastLoginCountry    String?    @map("last_login_country") @db.VarChar(2)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  roles                    UserRole[]
  assignedRoles            UserRole[]           @relation("AssignedRoles")
  emailChallenges          EmailChallenge[]
  passwordResetGrants      PasswordResetGrant[]
  updatedSettings          SystemSetting[]      @relation("SettingUpdater")
  studentProfile           StudentProfile?
  facultyProfile           FacultyProfile?
  approvedFacultyProfiles  FacultyProfile[]     @relation("FacultyApprover")
  verifiedDocuments        FacultyDocument[]    @relation("DocumentVerifier")
  uploadedLibraryMaterials LibraryMaterial[]    @relation("LibraryUploader")
  libraryReviews           LibraryReview[]      @relation("LibraryReviewer")
  policyAcceptances        PolicyAcceptance[]
  facultyInvitationsSent   FacultyInvitation[]  @relation("FacultyInviter")

  @@map("users")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  parentId    String?   @map("parent_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent      Role?            @relation("RoleInheritance", fields: [parentId], references: [id])
  children    Role[]           @relation("RoleInheritance")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(150)
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(50) // 'create' | 'read' | 'update' | 'delete' | 'manage'
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("AssignedRoles", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([userId, roleId], name: "pk_user_roles")
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  conditions   Json?    @db.Json

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId], name: "pk_role_permissions")
  @@map("role_permissions")
}

model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @map("token_hash") @db.VarChar(64)
  jti               String?   @unique @db.VarChar(100)
  used              Boolean   @default(false)
  portal            String?   @db.VarChar(20) // 'student' | 'faculty' | 'admin'
  familyId          String?   @map("family_id") @db.VarChar(100)
  reauthenticatedAt DateTime? @map("reauthenticated_at")
  revokedAt         DateTime? @map("revoked_at")
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.Text
  deviceFingerprint String?   @map("device_fingerprint") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, used])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  traceId           String   @map("trace_id") @db.VarChar(100)
  correlationId     String   @map("correlation_id") @db.VarChar(100)
  actorId           String?  @map("actor_id") @db.Uuid
  ipAddress         String   @map("ip_address") @db.VarChar(45)
  userAgent         String   @map("user_agent") @db.Text
  deviceFingerprint String?  @map("device_fingerprint") @db.VarChar(64)
  severity          String   @db.VarChar(20) // 'INFO' | 'WARN' | 'SECURITY' | 'CRITICAL'
  entity            String   @db.VarChar(100) // e.g., 'user', 'role', 'feature_flag'
  action            String   @db.VarChar(100)
  resourceId        String?  @map("resource_id") @db.VarChar(100)
  previousValue     Json?    @map("previous_value") @db.Json
  newValue          Json?    @map("new_value") @db.Json
  hash              String   @db.VarChar(64)
  previousHash      String   @map("previous_hash") @db.VarChar(64)
  // Position in the hash chain. Links and verification follow this, never created_at,
  // because several records can share a millisecond (LMS-102).
  sequence          BigInt   @unique @default(autoincrement())
  createdAt         DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model FeatureFlag {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @unique @db.VarChar(100)
  description       String?  @db.Text
  isEnabled         Boolean  @default(false) @map("is_enabled")
  rolloutPercentage Int      @default(0) @map("rollout_percentage")
  conditions        Json?    @db.Json
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("notifications")
}

model EmailChallenge {
  id                          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                      String?          @map("user_id") @db.Uuid
  email                       String           @db.VarChar(255)
  otpHash                     String           @map("otp_hash") @db.VarChar(64)
  purpose                     ChallengePurpose
  attemptsRemaining           Int              @default(3) @map("attempts_remaining")
  expiresAt                   DateTime         @map("expires_at")
  consumedAt                  DateTime?        @map("consumed_at")
  resendCooldownUntil         DateTime         @map("resend_cooldown_until")
  // REGISTRATION challenges run before the account exists (userId null). A verified
  // OTP issues a single-use registration token; only its SHA-256 hash is stored.
  registrationTokenHash       String?          @unique @map("registration_token_hash") @db.VarChar(64)
  registrationTokenExpiresAt  DateTime?        @map("registration_token_expires_at")
  registrationTokenConsumedAt DateTime?        @map("registration_token_consumed_at")
  createdAt                   DateTime         @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("email_challenges")
}

model PasswordResetGrant {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  grantHash  String    @unique @map("grant_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_grants")
}

model SystemSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json     @db.JsonB
  description String?  @db.Text
  revision    Int      @default(1)
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updater User? @relation("SettingUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

// Student onboarding steps 1-3. Minor status is always computed from dateOfBirth;
// a stored flag would go stale on the student's 18th birthday.
model StudentProfile {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String                @unique @map("user_id") @db.Uuid
  dateOfBirth             DateTime              @map("date_of_birth") @db.Date
  categoryId              String                @map("category_id") @db.Uuid
  // Required only when the category requires a board (School); enforced by the service
  boardId                 String?               @map("board_id") @db.Uuid
  levelId                 String                @map("level_id") @db.Uuid
  teachingLanguageId      String                @map("teaching_language_id") @db.Uuid
  // Guardian contact, required while the student is under 18. Contact only, not an account.
  guardianName            String?               @map("guardian_name") @db.VarChar(150)
  guardianRelationship    GuardianRelationship? @map("guardian_relationship")
  guardianMobileNumber    String?               @map("guardian_mobile_number") @db.VarChar(16)
  guardianEmail           String?               @map("guardian_email") @db.VarChar(255)
  // "Also send progress reports and payment receipts to the guardian"
  guardianReceivesReports Boolean               @default(false) @map("guardian_receives_reports")
  // Revenue reports group by country; derived from the mobile number's dialling code at registration
  country                 String                @db.VarChar(2)
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  countryRef       Country           @relation(fields: [country], references: [code], onDelete: Restrict)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  board            Board?            @relation(fields: [boardId], references: [id], onDelete: Restrict)
  level            Level             @relation(fields: [levelId], references: [id], onDelete: Restrict)
  teachingLanguage TeachingLanguage  @relation(fields: [teachingLanguageId], references: [id], onDelete: Restrict)
  subjects         StudentSubject[]
  guardianConsents GuardianConsent[]

  @@index([categoryId, boardId, levelId])
  @@map("student_profiles")
}

// Step 2 subject multi-select. A curriculum is one subject within the profile's
// category/board/level, so each selection is valid for that combination.
model StudentSubject {
  studentId    String   @map("student_id") @db.Uuid
  curriculumId String   @map("curriculum_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  curriculum Curriculum     @relation(fields: [curriculumId], references: [id], onDelete: Restrict)

  @@id([studentId, curriculumId], name: "pk_student_subjects")
  @@index([curriculumId])
  @@map("student_subjects")
}

// Step 2 "preferred teaching language" options, e.g. "English & Hindi" -> [en, hi].
// languageCodes (ISO 639-1) also back faculty search by language.
model TeachingLanguage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String   @unique @db.VarChar(50)
  name          String   @db.VarChar(100)
  languageCodes String[] @map("language_codes") @db.VarChar(8)
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  students StudentProfile[]

  @@map("teaching_languages")
}

// Client-supplied legal texts shown in onboarding step 4 and the signing modal.
// At most one current version per type is enforced by the service.
model PolicyDocument {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        PolicyType
  // Policies are chosen by the student's country and never fall back to another country's text
  country     String     @db.VarChar(2)
  version     String     @db.VarChar(20)
  title       String     @db.VarChar(200)
  effectiveAt DateTime   @map("effective_at")
  // Blank PDF served for preview and signing
  storageKey  String     @unique @map("storage_key") @db.VarChar(255)
  sha256      String     @db.VarChar(64)
  isCurrent   Boolean    @default(false) @map("is_current")
  createdAt   DateTime   @default(now()) @map("created_at")

  countryRef  Country            @relation(fields: [country], references: [code], onDelete: Restrict)
  acceptances PolicyAcceptance[]
  consents    GuardianConsent[]

  // One current version per (type, country) is enforced by a partial unique index added in SQL
  // (policy_documents_current_per_type_country); the policies service also checks it in its transaction.
  @@unique([type, country, version], name: "uk_policy_type_country_version")
  @@index([type, country, isCurrent])
  @@map("policy_documents")
}

model PolicyAcceptance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  policyId   String   @map("policy_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  acceptedAt DateTime @default(now()) @map("accepted_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy PolicyDocument @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([userId, policyId], name: "uk_user_policy_acceptance")
  @@map("policy_acceptances")
}

// Parent/guardian signature on the Student Terms, made in the date-of-birth popup
// before the account exists. The signing response returns a single-use consent
// token (only its hash is stored); registration links the row to the profile.
// Unlinked rows past expiresAt are purged together with their PDFs.
model GuardianConsent {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId            String?               @map("student_id") @db.Uuid
  policyId             String                @map("policy_id") @db.Uuid
  tokenHash            String                @unique @map("token_hash") @db.VarChar(64)
  // Step 1 values the signature was given for; registration must match them exactly
  studentFullName      String                @map("student_full_name") @db.VarChar(150)
  studentDateOfBirth   DateTime              @map("student_date_of_birth") @db.Date
  signatureMode        SignatureMode         @map("signature_mode")
  typedName            String?               @map("typed_name") @db.VarChar(150)
  signedPdfStorageKey  String                @unique @map("signed_pdf_storage_key") @db.VarChar(255)
  signedPdfSha256      String                @map("signed_pdf_sha256") @db.VarChar(64)
  ipAddress            String                @map("ip_address") @db.VarChar(45)
  userAgent            String?               @map("user_agent") @db.Text
  signedAt             DateTime              @default(now()) @map("signed_at")
  expiresAt            DateTime              @map("expires_at")
  linkedAt             DateTime?             @map("linked_at")
  // Guardian identity from step 3, copied when the consent is linked
  guardianName         String?               @map("guardian_name") @db.VarChar(150)
  guardianRelationship GuardianRelationship? @map("guardian_relationship")

  // A signed consent of a minor is a legal record: deleting the student profile is refused while it exists
  student StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  policy  PolicyDocument  @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([studentId, policyId], name: "uk_student_policy_consent")
  @@index([expiresAt, linkedAt])
  @@map("guardian_consents")
}

model FacultyProfile {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                @unique @map("user_id") @db.Uuid
  headline        String?               @db.VarChar(200)
  bio             String?               @db.Text
  experienceYears Decimal?              @map("experience_years") @db.Decimal(4, 1)
  primarySubject  String?               @map("primary_subject") @db.VarChar(100)
  approvalStatus  FacultyApprovalStatus @default(PENDING) @map("approval_status")
  isPublished     Boolean               @default(false) @map("is_published")
  isActive        Boolean               @default(true) @map("is_active")
  rejectionReason String?               @map("rejection_reason") @db.Text
  approvedAt      DateTime?             @map("approved_at")
  approvedBy      String?               @map("approved_by") @db.Uuid
  revision        Int                   @default(1)
  ratingsAverage  Decimal               @default(0.00) @map("ratings_average") @db.Decimal(3, 2)
  ratingsCount    Int                   @default(0) @map("ratings_count")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver User? @relation("FacultyApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  qualifications   FacultyQualification[]
  experiences      FacultyExperience[]
  documents        FacultyDocument[]
  termsAcceptances FacultyTermsAcceptance[]
  assignments      FacultyAssignment[]
  priceRules       PriceRule[]

  @@index([approvalStatus, isPublished, isActive])
  @@map("faculty_profiles")
}

// Admin invitation to join as a tutor (LMS-79). The user and faculty profile are
// created when the invitee completes onboarding. Only the SHA-256 hash of the
// single-use token is stored. Hand-written in the migration: the partial unique
// index allowing one PENDING invitation per email.
model FacultyInvitation {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String                    @db.VarChar(255)
  tokenHash      String                    @unique @map("token_hash") @db.VarChar(64)
  status         FacultyInvitationStatus   @default(PENDING)
  deliveryMethod FacultyInvitationDelivery @default(EMAIL) @map("delivery_method")
  sentAt         DateTime?                 @map("sent_at")
  expiresAt      DateTime                  @map("expires_at")
  acceptedAt     DateTime?                 @map("accepted_at")
  revokedAt      DateTime?                 @map("revoked_at")
  revokedReason  String?                   @map("revoked_reason") @db.VarChar(50)
  deliveryError  String?                   @map("delivery_error") @db.VarChar(255)
  invitedById    String?                   @map("invited_by_id") @db.Uuid
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  invitedBy User? @relation("FacultyInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([status, expiresAt])
  @@map("faculty_invitations")
}

model FacultyQualification {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId     String   @map("faculty_id") @db.Uuid
  degree        String   @db.VarChar(150)
  fieldOfStudy  String   @map("field_of_study") @db.VarChar(150)
  institution   String   @db.VarChar(200)
  yearOfPassing Int      @map("year_of_passing")
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  faculty FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@map("faculty_qualifications")
}

model FacultyExperience {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId    String   @map("faculty_id") @db.Uuid
  organization String   @db.VarChar(200)
  designation  String   @db.VarChar(150)
  startYear    Int      @map("start_year")
  endYear      Int?     @map("end_year")
  isCurrent    Boolean  @default(false) @map("is_current")
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  faculty FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@map("faculty_experiences")
}

model FacultyDocument {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId        String              @map("faculty_id") @db.Uuid
  documentType     FacultyDocumentType @map("document_type")
  originalFileName String              @map("original_file_name") @db.VarChar(255)
  fileSize         Int                 @map("file_size")
  mimeType         String              @map("mime_type") @db.VarChar(100)
  storageKey       String              @unique @map("storage_key") @db.VarChar(255)
  scanStatus       DocumentScanStatus  @default(PENDING) @map("scan_status")
  scanResult       String?             @map("scan_result") @db.Text
  isVerified       Boolean             @default(false) @map("is_verified")
  verifiedAt       DateTime?           @map("verified_at")
  verifiedBy       String?             @map("verified_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  faculty  FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  verifier User?          @relation("DocumentVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([facultyId])
  @@index([scanStatus])
  @@map("faculty_documents")
}

model FacultyTerms {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     String   @unique @db.VarChar(20)
  title       String   @db.VarChar(200)
  content     String   @db.Text
  effectiveAt DateTime @map("effective_at")
  isCurrent   Boolean  @default(false) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")

  acceptances FacultyTermsAcceptance[]

  @@map("faculty_terms")
}

model FacultyTermsAcceptance {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId    String   @map("faculty_id") @db.Uuid
  termsId      String   @map("terms_id") @db.Uuid
  termsVersion String   @map("terms_version") @db.VarChar(20)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  acceptedAt   DateTime @default(now()) @map("accepted_at")

  faculty FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  terms   FacultyTerms   @relation(fields: [termsId], references: [id], onDelete: Restrict)

  @@unique([facultyId, termsId], name: "uk_faculty_terms_acceptance")
  @@map("faculty_terms_acceptances")
}

// Category tree (ADR-0005). The tree is categories only; board, subject and level are
// lookups attached to leaves through curricula and category_levels. Only leaves can be
// bookable. path/depth are materialised; version guards optimistic concurrency.
// Hand-written in the migrations and not modelled here: CHECK constraints, the
// NULLS NOT DISTINCT sibling index, text_pattern_ops path indexes and the deferred
// tree / reference triggers. Remove any statement `migrate dev` generates to drop them.
model Category {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  // Unique among siblings (index categories_parent_id_code_key, NULLS NOT DISTINCT)
  code          String   @db.VarChar(50)
  name          String   @db.VarChar(100)
  description   String?  @db.Text
  path          String   @unique @db.VarChar(500)
  depth         Int      @default(0)
  isBookable    Boolean  @default(false) @map("is_bookable")
  requiresBoard Boolean  @default(false) @map("requires_board")
  requiresLevel Boolean  @default(true) @map("requires_level")
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  parent        Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Category[]       @relation("CategoryTree")
  allowedLevels CategoryLevel[]
  curricula     Curriculum[]
  students      StudentProfile[]
  levels        Level[]
  node          CatalogueNode?

  @@unique([parentId, code])
  @@index([parentId, displayOrder])
  @@map("categories")
}

// Levels a bookable leaf allows (ADR-0005)
model CategoryLevel {
  categoryId String   @map("category_id") @db.Uuid
  levelId    String   @map("level_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  category  Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  level     Level        @relation(fields: [levelId], references: [id], onDelete: Restrict)
  curricula Curriculum[]

  @@id([categoryId, levelId])
  @@index([levelId])
  @@map("category_levels")
}

// Countries the platform serves (docs REGIONS.md). A new country is a row here, not a code change.
model Country {
  code               String   @id @db.VarChar(2)
  name               String   @db.VarChar(100)
  dialCode           String   @unique @map("dial_code") @db.VarChar(5)
  // National number (after the dialling code) as a regular expression
  mobilePattern      String   @map("mobile_pattern") @db.VarChar(100)
  defaultTimezone    String   @map("default_timezone") @db.VarChar(64)
  guardianConsentAge Int      @map("guardian_consent_age")
  isActive           Boolean  @default(true) @map("is_active")
  displayOrder       Int      @default(0) @map("display_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  students StudentProfile[]
  boards   Board[]
  policies PolicyDocument[]

  @@map("countries")
}

model Board {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  country   String   @default("IN") @db.VarChar(2)
  state     String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  // Dropdown order (screen 28a); ties sort by name
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  countryRef Country          @relation(fields: [country], references: [code], onDelete: Restrict)
  curricula  Curriculum[]
  students   StudentProfile[]
  nodes      CatalogueNode[]

  @@map("boards")
}

model Subject {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  curricula Curriculum[]
  nodes     CatalogueNode[]

  @@map("subjects")
}

model Level {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  // Optional category scope, so dropdowns show only that category's levels
  categoryId  String?  @map("category_id") @db.Uuid
  // Class 2 must sort before Class 10, so name order is not enough
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  curricula      Curriculum[]
  students       StudentProfile[]
  nodes          CatalogueNode[]
  categoryLevels CategoryLevel[]

  @@index([categoryId, sortOrder])
  @@map("levels")
}

model Curriculum {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  boardId    String?  @map("board_id") @db.Uuid
  subjectId  String   @map("subject_id") @db.Uuid
  // Null only when the leaf does not require a level (ADR-0005)
  levelId    String?  @map("level_id") @db.Uuid
  // The LEVEL leaf that owns this offering (ADR 0003). The tuple columns above are
  // copied from the leaf's ancestors and kept in sync by the catalogue service.
  nodeId     String?  @unique @map("node_id") @db.Uuid
  syllabus   String?  @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  board    Board?         @relation(fields: [boardId], references: [id], onDelete: Restrict)
  subject  Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  level    Level?         @relation(fields: [levelId], references: [id], onDelete: Restrict)
  node     CatalogueNode? @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  // The leaf must allow the level (composite FK, MATCH SIMPLE: skipped when levelId is null)
  allowedLevel CategoryLevel? @relation(fields: [categoryId, levelId], references: [categoryId, levelId], onDelete: Restrict, map: "curricula_category_id_level_id_fkey")

  assignments FacultyAssignment[]
  materials   LibraryMaterial[]
  priceRules  PriceRule[]
  students    StudentSubject[]

  @@unique([categoryId, boardId, subjectId, levelId], name: "uk_curriculum_tuple")
  @@map("curricula")
}

// Categories & Content tree (screen 28), ADR 0003. Each node of type BOARD, SUBJECT,
// LEVEL or CATEGORY references exactly one master row; the migration adds CHECK
// constraints for that, which Prisma does not model. rootId is the CATEGORY node the
// node belongs to and never changes, so one indexed query loads a whole category.
model CatalogueNode {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId       String?             @map("parent_id") @db.Uuid
  rootId         String              @map("root_id") @db.Uuid
  type           CatalogueNodeType
  name           String              @db.VarChar(200)
  slug           String              @db.VarChar(64)
  status         CatalogueNodeStatus @default(DRAFT)
  sortOrder      Int                 @default(0) @map("sort_order")
  categoryId     String?             @unique @map("category_id") @db.Uuid
  boardId        String?             @map("board_id") @db.Uuid
  subjectId      String?             @map("subject_id") @db.Uuid
  levelId        String?             @map("level_id") @db.Uuid
  // "Book a session" option; meaningful on CATEGORY nodes only
  bookingEnabled Boolean             @default(true) @map("booking_enabled")
  archivedAt     DateTime?           @map("archived_at")
  // Actor ids, kept without a FK so the identity schema stays untouched
  createdById    String?             @map("created_by_id") @db.Uuid
  updatedById    String?             @map("updated_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  parent     CatalogueNode?  @relation("CatalogueNodeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   CatalogueNode[] @relation("CatalogueNodeTree")
  root       CatalogueNode   @relation("CatalogueNodeRoot", fields: [rootId], references: [id], onDelete: Restrict)
  members    CatalogueNode[] @relation("CatalogueNodeRoot")
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  board      Board?          @relation(fields: [boardId], references: [id], onDelete: Restrict)
  subject    Subject?        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  level      Level?          @relation(fields: [levelId], references: [id], onDelete: Restrict)
  curriculum Curriculum?

  @@unique([parentId, slug], name: "uk_catalogue_node_sibling_slug")
  @@unique([parentId, boardId], name: "uk_catalogue_node_sibling_board")
  @@unique([parentId, subjectId], name: "uk_catalogue_node_sibling_subject")
  @@unique([parentId, levelId], name: "uk_catalogue_node_sibling_level")
  @@index([rootId, parentId, sortOrder])
  @@index([boardId])
  @@index([subjectId])
  @@index([levelId])
  @@map("catalogue_nodes")
}

model FacultyAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId    String   @map("faculty_id") @db.Uuid
  curriculumId String   @map("curriculum_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  faculty    FacultyProfile @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  curriculum Curriculum     @relation(fields: [curriculumId], references: [id], onDelete: Restrict)

  @@unique([facultyId, curriculumId], name: "uk_faculty_curriculum_assignment")
  @@map("faculty_assignments")
}

// Admin-set session price for one offering (curriculum), optionally for one tutor
// (LMS-58). facultyId null = the default price for the offering. Currency is INR
// and every session is 60 minutes, so neither is stored. gstPaise and
// studentPaysPaise are computed by the server on every write; CHECK constraints in
// the migration enforce the formula. At most one active rule per curriculum and
// tutor for any overlapping window, enforced in a locked transaction.
model PriceRule {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculumId      String    @map("curriculum_id") @db.Uuid
  facultyId         String?   @map("faculty_id") @db.Uuid
  sessionPricePaise Int       @map("session_price_paise")
  // Basis points; 1800 = 18%. Defaults from the GST setting once LMS-90 exists.
  gstRateBps        Int       @default(1800) @map("gst_rate_bps")
  gstPaise          Int       @map("gst_paise")
  studentPaysPaise  Int       @map("student_pays_paise")
  effectiveFrom     DateTime  @default(now()) @map("effective_from")
  // Exclusive end; null = open-ended
  effectiveTo       DateTime? @map("effective_to")
  isActive          Boolean   @default(true) @map("is_active")
  revision          Int       @default(1)
  // Actor ids, kept without a FK so the identity schema stays untouched
  createdById       String?   @map("created_by_id") @db.Uuid
  updatedById       String?   @map("updated_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  curriculum Curriculum      @relation(fields: [curriculumId], references: [id], onDelete: Restrict)
  faculty    FacultyProfile? @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  @@index([curriculumId, facultyId, isActive])
  @@index([facultyId])
  @@map("price_rules")
}

model LibraryMaterial {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String                  @db.VarChar(255)
  description  String?                 @db.Text
  kind         LibraryMaterialKind
  audience     LibraryMaterialAudience @default(STUDENT)
  status       LibraryModerationStatus @default(PENDING)
  curriculumId String?                 @map("curriculum_id") @db.Uuid
  storageKey   String?                 @map("storage_key") @db.VarChar(255)
  fileSize     Int?                    @map("file_size")
  mimeType     String?                 @map("mime_type") @db.VarChar(100)
  externalUrl  String?                 @map("external_url") @db.Text
  scanStatus   DocumentScanStatus      @default(PENDING) @map("scan_status")
  uploadedBy   String                  @map("uploaded_by") @db.Uuid
  revision     Int                     @default(1)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  uploader   User            @relation("LibraryUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  curriculum Curriculum?     @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  reviews    LibraryReview[]

  @@index([status, audience])
  @@index([curriculumId])
  @@map("library_materials")
}

model LibraryReview {
  id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId String                  @map("material_id") @db.Uuid
  reviewerId String                  @map("reviewer_id") @db.Uuid
  decision   LibraryModerationStatus
  notes      String?                 @db.Text
  createdAt  DateTime                @default(now()) @map("created_at")

  material LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  reviewer User            @relation("LibraryReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([materialId])
  @@map("library_reviews")
}
