# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development           # development | test | production
PORT=3000
API_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────────────────────────────
# Note: For tests, a separate test database should be set up, e.g. via DATABASE_URL overriding
DATABASE_URL=postgresql://postgres:password@localhost:5432/amentorz_dev?schema=public # SECRET

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED for runtime. These are auto-generated with fake values by
# tests/env-setup.ts during test runs — no .env needed to run `npm run test`.
JWT_SECRET=change-me-use-a-long-random-string-in-production       # SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-use-a-different-long-random-string   # SECRET
JWT_REFRESH_EXPIRES_IN=7d
JWT_SESSION_EXPIRES_IN=12h

# ── Cookies ───────────────────────────────────────────────────────────────────
# Used to sign session cookies. A fake value is injected for test runs.
COOKIE_SECRET=change-me-use-a-long-random-string-in-production    # SECRET

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                 # trace | debug | info | warn | error

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes in milliseconds
RATE_LIMIT_MAX=100             # max requests per window per IP
LOGIN_RATE_LIMIT_WINDOW_MS=900000     # window for the portal login limits (15 minutes)
LOGIN_RATE_LIMIT_MAX_PER_IP=20        # login attempts per window per IP
LOGIN_RATE_LIMIT_MAX_PER_EMAIL=10     # login attempts per window per email
REFRESH_RATE_LIMIT_WINDOW_MS=900000   # window for the refresh limit (15 minutes)
REFRESH_RATE_LIMIT_MAX_PER_IP=60      # refresh requests per window per IP
REAUTH_WINDOW_MINUTES=5               # how long a password confirmation stays fresh for sensitive actions
OTP_SEND_RATE_LIMIT_WINDOW_MS=900000     # window for sending email codes (15 minutes)
OTP_SEND_RATE_LIMIT_MAX_PER_IP=10        # codes requested per window per IP
OTP_SEND_RATE_LIMIT_MAX_PER_EMAIL=5      # codes requested per window per email
OTP_VERIFY_RATE_LIMIT_WINDOW_MS=900000   # window for checking email codes (15 minutes)
OTP_VERIFY_RATE_LIMIT_MAX_PER_IP=30      # code checks per window per IP
REAUTH_RATE_LIMIT_WINDOW_MS=900000    # window for the reauthenticate limit (15 minutes)
REAUTH_RATE_LIMIT_MAX_PER_IP=30       # reauthenticate attempts per window per IP

# ── Redis ─────────────────────────────────────────────────────────────────────
# Not used during tests — falls back to an in-memory store.
# If the URL includes credentials (redis://:password@host:port), treat as SECRET.
REDIS_URL=redis://localhost:6379

# ── Security / Account Lockout ────────────────────────────────────────────────
MAX_FAILED_LOGINS=5            # Number of failed attempts before account is locked
LOCKOUT_DURATION_MINUTES=15    # How long an account remains locked

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API with cookies.
# Required in production. In development and test an empty value allows the
# local admin, student and faculty apps (http://localhost:3001, 3002, 3003).
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# ── Guardian consent ──────────────────────────────────────────────────────────
CONSENT_UNLINKED_TTL_HOURS=24          # an unused signed consent is deleted with its PDF after this long
CONSENT_SIGNATURE_MAX_BYTES=1048576    # largest signature image accepted (1 MiB)
CONSENT_SIGN_RATE_LIMIT_WINDOW_MS=3600000
CONSENT_SIGN_RATE_LIMIT_MAX_PER_IP=10  # signing requests per window per IP
POLICY_MAX_BYTES=10485760              # largest policy PDF an admin can upload (10 MiB)
TRUST_PROXY_HOPS=0                     # reverse proxies in front of the app; set to 1 behind one load balancer

# ── File storage (signed consents, policy PDFs) ───────────────────────────────
# local keeps files under STORAGE_LOCAL_DIR (development). Production uses a private S3 bucket of its own,
# with versioning on (not the upload quarantine bucket); every download goes through the API.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_PREFIX=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Development can use a Gmail account with an app password. Production needs SMTP_HOST.
# EMAIL_TRANSPORT=memory keeps messages in process and is used by the tests only.
EMAIL_FROM="Amentorz <no-reply@example.org>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=                                                         # SECRET
SMTP_PASS=                                                         # SECRET

# ── One-time passwords (email) ────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
EMAIL_TOKEN_EXPIRES_MINUTES=30
PASSWORD_CHANGE_OTP_ROLES=admin     # who confirms a password change with an email code: admin or all
RESET_GRANT_EXPIRES_MINUTES=5        # how long a verified recovery code can be exchanged for a new password

# ── Razorpay (Confirmed Gateway) ──────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder                               # SECRET
RAZORPAY_KEY_SECRET=rzp_secret_placeholder                         # SECRET
RAZORPAY_WEBHOOK_SECRET=whsec_placeholder                           # SECRET

# ── Metrics ───────────────────────────────────────────────────────────────────
# REQUIRED in production (min 32 chars): Bearer token for GET /metrics.
METRICS_TOKEN=                                                     # SECRET

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1


# First super_admin, read only by `npm run create-admin` (no defaults; leave unset elsewhere)
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_NAME=
